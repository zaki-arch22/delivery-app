{
  "expo": {
    "name": "Delivery",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dz.delivery.app",
      "infoPlist": {
        "ExpoLocalization_supportsRTL": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2F6FED",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "dz.delivery.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ],
      "googleServicesFile": "./google-services.json",
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-localization",
        {
          "supportsRTL": false
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "The camera is used to photograph parcels at pickup, evidence of a problem, and your documents for driver sign-up.",
          "photosPermission": "Your photos are used only to choose pictures of your ID, driving licence and vehicle for driver sign-up.",
          "microphonePermission": false
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Your location places the pickup pin when you tap \"My location\", and, for drivers, shows the parcel's progress and proves where pickups and deliveries happen."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "The camera reads the QR code of a pickup or a delivery, and photographs parcels.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2F6FED",
          "icon": "./assets/notification-icon.png"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#121316",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ]
    ],
    "scheme": "delivery",
    "extra": {
      "eas": {
        "projectId": "85947c9a-3728-412f-939c-9cc15ab586c2"
      }
    },
    "owner": "delivery_platform",
    "updates": {
      "url": "https://u.expo.dev/85947c9a-3728-412f-939c-9cc15ab586c2"
    }
  }
}
