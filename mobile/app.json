{
  "expo": {
    "name": "Delivery",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dz.delivery.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E8EEFB",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "dz.delivery.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-localization",
        {
          "supportsRTL": false
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "The camera is used only to photograph your ID, driving licence and vehicle for driver sign-up.",
          "photosPermission": "Your photos are used only to choose pictures of your ID, driving licence and vehicle for driver sign-up.",
          "microphonePermission": false
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Your location is used to place the pickup pin where you are, only when you tap \"My location\"."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1E40AF"
        }
      ]
    ],
    "scheme": "delivery",
    "extra": {
      "eas": {
        "projectId": "85947c9a-3728-412f-939c-9cc15ab586c2"
      }
    },
    "owner": "delivery_platform"
  }
}
