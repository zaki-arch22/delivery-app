{
  "name": "mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/cairo": "^0.4.2",
    "expo": "~58.0.14",
    "expo-constants": "~58.0.12",
    "expo-font": "~58.0.8",
    "expo-linking": "~58.0.13",
    "expo-localization": "~58.0.4",
    "expo-router": "~58.0.23",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "~19.3.0",
    "@types/ws": "^8.18.2",
    "babel-preset-expo": "^58.0.17",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.11",
    "pg": "^8.23.1",
    "react-native-web": "^0.21.4",
    "typescript": "~6.0.3",
    "ws": "^8.22.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand"
  },
  "private": true,
  "overrides": {
    "uuid": "^11.1.1"
  },
  "jest": {
    "testTimeout": 30000,
    "projects": [
      {
        "displayName": "core (real network, real backend)",
        "testEnvironment": "node",
        "testMatch": [
          "<rootDir>/test/core*.test.ts"
        ],
        "transform": {
          "^.+\\.[jt]sx?$": "babel-jest"
        }
      },
      {
        "displayName": "screens",
        "preset": "jest-expo",
        "testMatch": [
          "<rootDir>/test/screen*.test.tsx"
        ]
      }
    ]
  }
}
