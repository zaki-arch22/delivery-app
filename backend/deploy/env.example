# Copy to /etc/delivery/env (permissions 600, owner = the service user). NEVER commit the real file.
# Generate each secret with:  openssl rand -base64 48
NODE_ENV=production
PORT=3000
TRUST_PROXY=1                       # 1 = the app sits behind ONE reverse proxy (Caddy)
STAFF_ORIGINS=                      # the staff console address, e.g. https://staff.yourdomain.dz  (empty = no browser access)

JWT_SECRET=
HASH_PEPPER=                        # different from JWT_SECRET

DATABASE_URL=                       # the LIMITED role (delivery_app) - what the app uses
OWNER_DATABASE_URL=                 # the owner - only for migrate / create-admin / reset-2fa / launch-check (do not give this to the running app)

UPLOAD_DIR=/var/lib/delivery/uploads   # private folder for driver document photos (created by the service, mode 700); include it in backups
ROUTING_URL=                        # our own OSRM server for road distances, e.g. http://127.0.0.1:5000 (see deploy/osrm.md); empty = straight-line estimate

FIREBASE_SERVICE_ACCOUNT_JSON=      # push notifications
SMS_DAILY_CAP=2000                  # hard daily limit on login SMS (fraud protection)
